<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- State Disabled -->
    <item
        android:alpha="0.12"
        android:color="@color/settingslib_materialColorOnSurface"
        android:state_enabled="false"/>
    <!-- State Enabled & Checked (Activated) -->
    <item
        android:state_activated="true"
        android:color="@color/settingslib_materialColorPrimaryContainer"/>
    <!-- State Enabled & Unchecked -->
    <item
        android:color="@color/settingslib_materialColorSurfaceContainerHigh"/>
</selector>
